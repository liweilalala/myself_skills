{
  "version": "1.0",
  "phases": [
    {
      "id": 1,
      "name": "原始需求分析",
      "agent": "test-req-preprocessor",
      "executionMode": "sequential",
      "steps": [
        {
          "id": "1.1",
          "name": "需求格式化",
          "skill": "word-to-markdown + requirement-document-preprocessor",
          "dependsOn": [],
          "inputFiles": ["{inputDoc}"],
          "outputFiles": ["doc.md", "requirements.md"],
          "task": "将设计文档转换为标准化需求文档。如果输入是.docx，先用word-to-markdown转换为doc.md；如果是.md，直接复制为doc.md。然后用requirement-document-preprocessor处理生成requirements.md。"
        },
        {
          "id": "1.2",
          "name": "客户问题识别",
          "skill": "mece-decomposition",
          "dependsOn": ["1.1"],
          "inputFiles": ["requirements.md", "doc.md"],
          "outputFiles": ["sub_problems.json"],
          "task": "使用mece-decomposition技能分析需求文档和格式化需求，识别客户问题，输出MECE分解后的客户问题列表。"
        },
        {
          "id": "1.3",
          "name": "5W2H分析",
          "skill": "5w2h-analysis",
          "dependsOn": ["1.2"],
          "inputFiles": ["sub_problems.json", "doc.md"],
          "outputFiles": ["sub_problems_5w2h.json"],
          "task": "使用5w2h-analysis技能对客户问题进行5W2H分析（What、Why、Who、When、Where、How、How much），输出分析结果。"
        },
        {
          "id": "1.4",
          "name": "术语替换",
          "skill": "term-dictionary",
          "dependsOn": ["1.3"],
          "inputFiles": ["sub_problems_5w2h.json", "sub_problems.json"],
          "outputFiles": ["sub_problems_5w2h_replaced.json", "sub_problems_replaced.json"],
          "task": "使用term-dictionary技能将文档中的术语替换为标准术语，生成术语替换后的文档版本。"
        },
        {
          "id": "1.5",
          "name": "L3规则提取",
          "skill": "l3-rule-extractor",
          "dependsOn": ["1.4"],
          "inputFiles": ["doc.md", "sub_problems_5w2h_replaced.json"],
          "outputFiles": ["rule_l3_atom.json"],
          "task": "使用l3-rule-extractor技能从文档和替换后的客户问题中提取L3级别（业务规则级别）的原子规则。"
        },
        {
          "id": "1.6",
          "name": "L4因子拆分",
          "skill": "l4-factor-extractor",
          "dependsOn": ["1.5"],
          "inputFiles": ["rule_l3_atom.json"],
          "outputFiles": ["rule_l4_factor.json", "rule_l3_l4_relation.json"],
          "task": "使用l4-factor-extractor技能将L3规则拆分为L4因子（测试因子），输出因子和关系文件。"
        },
        {
          "id": "1.7",
          "name": "Usecase提取",
          "skill": "usecase-extraction",
          "dependsOn": ["1.6"],
          "inputFiles": ["sub_problems_5w2h_replaced.json"],
          "outputFiles": ["usecase.json", "non_func_req.json"],
          "task": "使用usecase-extraction技能从替换后的客户问题中提取用例和非功能需求。"
        },
        {
          "id": "1.8",
          "name": "Usecase规则匹配",
          "skill": "usecase-rule-matcher",
          "dependsOn": ["1.7"],
          "inputFiles": ["usecase.json", "rule_l3_atom.json"],
          "outputFiles": ["usecase_with_rule.json"],
          "task": "使用usecase-rule-matcher技能将用例与提取的L3规则进行匹配，输出带规则的用例文件。"
        }
      ]
    },
    {
      "id": 2,
      "name": "测试需求分析",
      "agent": "test-requirement-analyst",
      "executionMode": "parallel",
      "branches": [
        {
          "branchId": 1,
          "name": "特性原子能力",
          "steps": [
            {
              "id": "2.1.1",
              "name": "Feature原子能力提取",
              "skill": "feature-tree-atomic-extraction",
              "dependsOn": ["1.8"],
              "inputFiles": ["doc.md"],
              "outputFiles": ["feature_atomic.json"],
              "task": "使用feature-tree-atomic-extraction技能从doc.md中提取特性原子能力，输出特性原子能力树。"
            },
            {
              "id": "2.1.2",
              "name": "Feature原子IBO填充",
              "skill": "feature-atomic-ibo-filler",
              "dependsOn": ["2.1.1"],
              "inputFiles": ["feature_atomic.json", "doc.md", "rule_l3_atom.json"],
              "outputFiles": ["feature_atomic_ibo.json"],
              "task": "使用feature-atomic-ibo-filler技能为特性原子能力填充IBO（Input/Behavior/Output）信息。"
            }
          ]
        },
        {
          "branchId": 2,
          "name": "实现原子能力",
          "steps": [
            {
              "id": "2.2.1",
              "name": "实现原子能力提取",
              "skill": "implementation-atomic-capability-extractor",
              "dependsOn": ["1.8"],
              "inputFiles": ["doc.md"],
              "outputFiles": ["implementation_atomic.json"],
              "task": "使用implementation-atomic-capability-extractor技能从doc.md中提取实现原子能力和接口信息。"
            },
            {
              "id": "2.2.2",
              "name": "接口IBO填充",
              "skill": "interface-ibo-filler",
              "dependsOn": ["2.2.1"],
              "inputFiles": ["doc.md", "implementation_atomic.json"],
              "outputFiles": ["implementation_atomic_ibo.json"],
              "task": "使用interface-ibo-filler技能为实现原子能力填充IBO（Input/Behavior/Output）信息。"
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "name": "测试设计",
      "agent": "test-design-expert",
      "executionMode": "parallel",
      "branches": [
        {
          "branchId": 1,
          "name": "逻辑测试用例",
          "steps": [
            {
              "id": "3.1.1",
              "name": "逻辑测试点生成",
              "skill": "feature-atomic-capability-testpoint-generation",
              "dependsOn": ["2.1.2"],
              "inputFiles": ["feature_atomic_ibo.json"],
              "outputFiles": ["logic_testpoint.json"],
              "task": "使用feature-atomic-capability-testpoint-generation技能从特性原子IBO生成逻辑测试点。"
            },
            {
              "id": "3.1.2",
              "name": "逻辑测试用例生成",
              "skill": "testpoint-to-testcase",
              "dependsOn": ["3.1.1"],
              "inputFiles": ["logic_testpoint.json"],
              "outputFiles": ["logic_testcase.json"],
              "task": "使用testpoint-to-testcase技能将逻辑测试点转换为逻辑测试用例。"
            },
            {
              "id": "3.1.3",
              "name": "逻辑测试用例导出",
              "skill": "logic-testcase-to-excel",
              "dependsOn": ["3.1.2"],
              "inputFiles": ["logic_testpoint.json", "logic_testcase.json"],
              "outputFiles": ["logic_testcase_export.xlsx"],
              "task": "使用logic-testcase-to-excel技能将逻辑测试用例导出为Excel格式。"
            }
          ]
        },
        {
          "branchId": 2,
          "name": "接口测试用例",
          "steps": [
            {
              "id": "3.2.1",
              "name": "接口测试点生成",
              "skill": "interface-testpoint-generation",
              "dependsOn": ["2.2.2"],
              "inputFiles": ["implementation_atomic_ibo.json", "rule_l3_atom.json"],
              "outputFiles": ["interface_testpoint.json"],
              "task": "使用interface-testpoint-generation技能从实现原子IBO和规则生成接口测试点。"
            },
            {
              "id": "3.2.2",
              "name": "接口测试用例生成",
              "skill": "testpoint-to-testcase",
              "dependsOn": ["3.2.1"],
              "inputFiles": ["interface_testpoint.json"],
              "outputFiles": ["interface_testcase.json"],
              "task": "使用testpoint-to-testcase技能将接口测试点转换为接口测试用例。"
            },
            {
              "id": "3.2.3",
              "name": "接口测试用例导出",
              "skill": "interface-testcase-to-excel",
              "dependsOn": ["3.2.2"],
              "inputFiles": ["interface_testpoint.json", "interface_testcase.json"],
              "outputFiles": ["interface_testcase_export.xlsx"],
              "task": "使用interface-testcase-to-excel技能将接口测试用例导出为Excel格式。"
            }
          ]
        }
      ]
    }
  ]
}
